+_TYPE_KEY = '__tinydb_type__'
+
+
+def _encode(obj: Any) -> Any:
+    """Replace datetime/date values with tagged JSON objects (recursively)."""
+    if isinstance(obj, datetime):
+        return {_TYPE_KEY: 'datetime', 'value': obj.isoformat()}
+    if isinstance(obj, date):
+        return {_TYPE_KEY: 'date', 'value': obj.isoformat()}
+    if isinstance(obj, dict):
+        return {k: _encode(v) for k, v in obj.items()}
+    if isinstance(obj, (list, tuple)):
+        return [_encode(v) for v in obj]
+    return obj
+
+
+def _decode(obj: dict) -> Any:
+    """``object_hook`` that turns tagged objects back into datetime/date."""
+    if len(obj) == 2 and obj.get(_TYPE_KEY) == 'datetime':
+        return datetime.fromisoformat(obj['value'])
+    if len(obj) == 2 and obj.get(_TYPE_KEY) == 'date':
+        return date.fromisoformat(obj['value'])
+    return obj
