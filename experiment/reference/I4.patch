index 3f6c6ab..b0c0473 100644
--- a/tinydb/operations.py
+++ b/tinydb/operations.py
@@ -73,3 +73,17 @@ def decrement(field: str) -> Callable[[MutableMapping], None]:
         doc[field] -= 1
 
     return transform
+
+
+def append(field: str, value: Any) -> Callable[[MutableMapping], None]:
+    """
+    Append ``value`` to the list stored in ``field``, creating the list if the
+    field does not exist yet.
+    """
+    def transform(doc: MutableMapping):
+        if field in doc:
+            doc[field].append(value)
+        else:
+            doc[field] = [value]
+
+    return transform
